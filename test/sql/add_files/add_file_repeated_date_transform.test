# name: test/sql/add_files/add_file_repeated_date_transform.test
# description: add-files preserves each partition key when one date has repeated transforms
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db

test-env DATA_PATH __TEST_DIR__

statement ok
ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/repeated_date/', METADATA_CATALOG 'metadata');

statement ok
USE ducklake

statement ok
CREATE TABLE dates(id INTEGER, dt DATE)

statement ok
ALTER TABLE dates SET PARTITIONED BY (year(dt), month(dt))

statement ok
COPY (SELECT 0 AS directory_seed, 2025 AS year, 7 AS month UNION ALL SELECT 0, 2025, 8) TO '${DATA_PATH}/repeated_date/' (FORMAT PARQUET, PARTITION_BY (year, month))

statement ok
COPY (SELECT 1 id, DATE '2025-07-03' dt) TO '${DATA_PATH}/repeated_date/year=2025/month=7/one.parquet' (FORMAT PARQUET)

statement ok
CALL ducklake_add_data_files('ducklake', 'dates', '${DATA_PATH}/repeated_date/year=2025/month=7/one.parquet')

query IT
SELECT partition_key_index, partition_value FROM metadata.ducklake_file_partition_value ORDER BY partition_key_index
----
0	2025
1	7

query II
SELECT * FROM dates WHERE year(dt)=2025 AND month(dt)=7
----
1	2025-07-03

statement ok
COPY (SELECT 2 id, DATE '2025-08-04' dt) TO '${DATA_PATH}/repeated_date/year=2025/missing.parquet' (FORMAT PARQUET)

statement error
CALL ducklake_add_data_files('ducklake', 'dates', '${DATA_PATH}/repeated_date/year=2025/missing.parquet')
----
contains an invalid partition value for the table configuration

statement ok
COPY (SELECT 0 AS directory_seed, 2025 AS year, 4 AS day) TO '${DATA_PATH}/repeated_date/' (FORMAT PARQUET, PARTITION_BY (year, day), APPEND)

statement ok
COPY (SELECT 3 id, DATE '2025-08-04' dt) TO '${DATA_PATH}/repeated_date/year=2025/day=4/wrong.parquet' (FORMAT PARQUET)

statement error
CALL ducklake_add_data_files('ducklake', 'dates', '${DATA_PATH}/repeated_date/year=2025/day=4/wrong.parquet')
----
contains an invalid partition value for the table configuration

statement ok
COPY (SELECT 4 id, DATE '2025-08-04' dt) TO '${DATA_PATH}/repeated_date/year=2025/month=8/rollback.parquet' (FORMAT PARQUET)

statement ok
BEGIN

statement ok
CALL ducklake_add_data_files('ducklake', 'dates', '${DATA_PATH}/repeated_date/year=2025/month=8/rollback.parquet')

query I
SELECT count(*) FROM dates
----
2

statement ok
ROLLBACK

query II
SELECT * FROM dates
----
1	2025-07-03

query I
SELECT count(*) FROM metadata.ducklake_file_partition_value
----
2

query I
SELECT count(*) FROM glob('${DATA_PATH}/repeated_date/year=2025/month=8/rollback.parquet')
----
1

# Concurrent ordinary writers must retain the imported partitioned row.
statement ok
SET ducklake_retry_wait_ms=10

concurrentloop i 10 12

statement ok
INSERT INTO ducklake.dates VALUES (${i}, DATE '2025-09-01')

endloop

query II rowsort
SELECT * FROM dates
----
1	2025-07-03
10	2025-09-01
11	2025-09-01

query I
SELECT count(*) FROM dates WHERE year(dt)=2025 AND month(dt)=7
----
1

statement ok
CREATE TABLE collision(day DATE, year INTEGER, month INTEGER, hour INTEGER)

statement ok
ALTER TABLE collision SET PARTITIONED BY (year(day), month(day), day(day))

statement ok
COPY (SELECT 0 AS directory_seed, 2025 AS year, 7 AS month, 3 AS day) TO '${DATA_PATH}/collision/' (FORMAT PARQUET, PARTITION_BY (year, month, day))

statement ok
COPY (SELECT DATE '2025-07-03' AS day, 19 AS year, 23 AS month, 17 AS hour) TO '${DATA_PATH}/collision/year=2025/month=7/day=3/payload.parquet' (FORMAT PARQUET)

statement ok
CALL ducklake_add_data_files('ducklake', 'collision', '${DATA_PATH}/collision/year=2025/month=7/day=3/payload.parquet')

query IIII
SELECT * FROM collision
----
2025-07-03	19	23	17

query IT
SELECT partition_key_index, partition_value FROM metadata.ducklake_file_partition_value WHERE data_file_id IN (SELECT data_file_id FROM metadata.ducklake_data_file WHERE path LIKE '%payload.parquet') ORDER BY partition_key_index
----
0	2025
1	7
2	3

statement ok
COPY (SELECT DATE '2025-07-03' AS day, 23 AS month, 17 AS hour) TO '${DATA_PATH}/collision/year=2025/month=7/day=3/missing_year.parquet' (FORMAT PARQUET)

statement error
CALL ducklake_add_data_files('ducklake', 'collision', '${DATA_PATH}/collision/year=2025/month=7/day=3/missing_year.parquet')
----
was not found in file

# Unpartitioned Hive imports still fill columns omitted from Parquet.
statement ok
CREATE TABLE unpartitioned(id INTEGER, year INTEGER)

statement ok
COPY (SELECT 91 AS id) TO '${DATA_PATH}/repeated_date/year=2025/unpartitioned.parquet' (FORMAT PARQUET)

statement ok
CALL ducklake_add_data_files('ducklake', 'unpartitioned', '${DATA_PATH}/repeated_date/year=2025/unpartitioned.parquet')

query II
SELECT * FROM unpartitioned
----
91	2025
